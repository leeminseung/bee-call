# The voice server: the LiveKit worker registered as bee-call, which LiveKit Cloud dispatches every call to
# (voice/agent.py). `start` is LiveKit's production mode; the worker keeps one idle job process ready
# (num_idle_processes=1 in voice/agent.py) and starts another for each call.
[Unit]
Description=Bee Call voice server (LiveKit worker bee-call)
Wants=bee-call-env.service network-online.target
After=bee-call-env.service network-online.target

[Service]
User=bee-call
Group=bee-call
WorkingDirectory=/opt/bee-call/app
EnvironmentFile=/run/bee-call/env
Environment=TZ=Asia/Seoul
Environment=BEE_CALL_DATA=/var/lib/bee-call
Environment=BEE_BIN=/opt/bee-call/bin/bee
Environment=BEE_FORCE_FILE_STORE=1
Environment=LIVEKIT_AGENT_NAME=bee-call
Environment=PYTHONUNBUFFERED=1
# The calls use LiveKit's cloud turn detector (voice/agent.py), so the local one is not loaded up front; it loads
# only if the cloud one fails. Saves about 250 MB. Remove this line if voice/agent.py goes back to the local model.
Environment=LIVEKIT_AGENTS_PRELOAD_LOCAL_INFERENCE=0
ExecStart=/opt/bee-call/app/.venv/bin/python -m voice.agent start
Restart=always
RestartSec=5
# On stop, only the worker gets SIGTERM: it takes no new calls and waits for the ones in progress, up to
# TimeoutStopSec, before its job processes are killed.
KillMode=mixed
TimeoutStopSec=10min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
