# Caddy: HTTPS with a Let's Encrypt certificate in front of the token server (443) and the session screen (8443).
# Off until deploy/config.py has written /etc/caddy/Caddyfile for a hostname. Certificates are kept in
# /var/lib/caddy, the caddy user's home. Based on Caddy's own caddy.service.
[Unit]
Description=Caddy, HTTPS for Bee Call
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/caddy/Caddyfile

[Service]
Type=notify
User=caddy
Group=caddy
Environment=TZ=Asia/Seoul
ExecStart=/opt/bee-call/bin/caddy run --config /etc/caddy/Caddyfile
ExecReload=/opt/bee-call/bin/caddy reload --config /etc/caddy/Caddyfile --force
TimeoutStopSec=5s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
