# Writes /run/bee-call/env (root only) and the APNs key from SSM Parameter Store /bee-call/, before the services
# start (deploy/config.py). If SSM cannot be read, it tries again every 30 s; the services keep restarting until
# the file is there. A failed read on an update leaves the last file in place, so they run on with it.
[Unit]
Description=Bee Call settings from SSM Parameter Store
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/bee-call/app
ExecStart=/opt/bee-call/app/.venv/bin/python -m deploy.config env
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
