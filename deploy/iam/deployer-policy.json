{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ServerInstance",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances", "ec2:DescribeImages", "ec2:DescribeVpcs", "ec2:DescribeSecurityGroups",
        "ec2:DescribeAddresses", "ec2:CreateSecurityGroup", "ec2:AuthorizeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup", "ec2:RunInstances", "ec2:TerminateInstances", "ec2:CreateTags",
        "ec2:AllocateAddress", "ec2:AssociateAddress", "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-southeast-2"}}
    },
    {
      "Sid": "GiveTheInstanceItsRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::515927224114:role/bee-call-server",
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    },
    {
      "Sid": "Settings",
      "Effect": "Allow",
      "Action": ["ssm:PutParameter", "ssm:GetParameter", "ssm:DeleteParameter"],
      "Resource": "arn:aws:ssm:ap-southeast-2:515927224114:parameter/bee-call/*"
    },
    {
      "Sid": "SettingNamesAndCommandResults",
      "Effect": "Allow",
      "Action": ["ssm:DescribeParameters", "ssm:GetCommandInvocation", "ssm:DescribeInstanceInformation"],
      "Resource": "*"
    },
    {
      "Sid": "LatestAmazonLinux",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-southeast-2::parameter/aws/service/ami-amazon-linux-latest/*"
    },
    {
      "Sid": "RunCommandDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:ap-southeast-2::document/AWS-RunShellScript"
    },
    {
      "Sid": "RunCommandOnTheServerOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:ap-southeast-2:515927224114:instance/*",
      "Condition": {"StringEquals": {"ssm:resourceTag/Name": "bee-call-server"}}
    },
    {
      "Sid": "Dns",
      "Effect": "Allow",
      "Action": ["route53:ListHostedZones", "route53:GetChange"],
      "Resource": "*"
    },
    {
      "Sid": "DnsRecords",
      "Effect": "Allow",
      "Action": ["route53:ListResourceRecordSets", "route53:ChangeResourceRecordSets"],
      "Resource": "arn:aws:route53:::hostedzone/*"
    }
  ]
}
