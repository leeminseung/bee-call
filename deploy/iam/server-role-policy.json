{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CoordinatorPrepMetaAgentAndWebSearch",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:*:ACCOUNT_ID:inference-profile/*"
      ]
    },
    {
      "Sid": "WebSearchThroughNovaWebGrounding",
      "Effect": "Allow",
      "Action": "bedrock:InvokeTool",
      "Resource": "arn:aws:bedrock::ACCOUNT_ID:system-tool/amazon.nova_grounding"
    },
    {
      "Sid": "BackgroundWorker",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeHarness",
      "Resource": "arn:aws:bedrock-agentcore:ap-southeast-2:ACCOUNT_ID:harness/*"
    },
    {
      "Sid": "SpeechToText",
      "Effect": "Allow",
      "Action": ["transcribe:StartStreamTranscription", "transcribe:StartStreamTranscriptionWebSocket"],
      "Resource": "*"
    },
    {
      "Sid": "TextToSpeech",
      "Effect": "Allow",
      "Action": "polly:SynthesizeSpeech",
      "Resource": "*"
    },
    {
      "Sid": "SettingsFromParameterStore",
      "Effect": "Allow",
      "Action": ["ssm:GetParametersByPath", "ssm:GetParameter"],
      "Resource": [
        "arn:aws:ssm:ap-southeast-2:ACCOUNT_ID:parameter/bee-call",
        "arn:aws:ssm:ap-southeast-2:ACCOUNT_ID:parameter/bee-call/*"
      ]
    }
  ]
}
