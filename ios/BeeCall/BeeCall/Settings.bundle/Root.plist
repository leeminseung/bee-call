<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>StringsTable</key>
	<string>Root</string>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Calls</string>
			<key>FooterText</key>
			<string>The evening time Bee Call suggests when it asks to call (24-hour, like 21:00). Haiku answers faster. Sonnet thinks more and answers a little slower. The call language and the voice are in Bee Call's own settings.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Call model</string>
			<key>Key</key>
			<string>call_model</string>
			<key>DefaultValue</key>
			<string>haiku</string>
			<key>Titles</key>
			<array>
				<string>Haiku 5.5 (faster)</string>
				<string>Sonnet 5.5 (smarter)</string>
			</array>
			<key>Values</key>
			<array>
				<string>haiku</string>
				<string>sonnet</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSTextFieldSpecifier</string>
			<key>Title</key>
			<string>Evening call time</string>
			<key>Key</key>
			<string>call_time</string>
			<key>DefaultValue</key>
			<string>21:00</string>
			<key>KeyboardType</key>
			<string>NumbersAndPunctuation</string>
			<key>AutocapitalizationType</key>
			<string>None</string>
			<key>AutocorrectionType</key>
			<string>No</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Call audio</string>
			<key>FooterText</key>
			<string>The written record of each call is always kept on the server. These switches are only about the sound. Turning “Save on the server” off stops recording new calls there. Recordings made before stay. On this iPhone, recordings appear in the Files app under On My iPhone, Bee Call.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Save on the server</string>
			<key>Key</key>
			<string>record_on_server</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Save on this iPhone</string>
			<key>Key</key>
			<string>record_on_phone</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Bee</string>
			<key>FooterText</key>
			<string>Lets the AI read your day from your Bee and call about it. Turn it on, open Bee Call, and approve it in the Bee app.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Use Bee</string>
			<key>Key</key>
			<string>use_bee</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
	</array>
</dict>
</plist>
