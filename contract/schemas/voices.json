{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.bee-call.invalid/schemas/voices.json",
  "title": "GET /voices?language=: the voices of one call language",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "voices"],
  "properties": {
    "language": {"enum": ["en", "ko"]},
    "voices": {
      "description": "Five voices, in the order to list them. Exactly one is the default.",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "defs.json#/$defs/voice"},
      "contains": {"properties": {"default": {"const": true}}},
      "minContains": 1,
      "maxContains": 1
    }
  }
}
