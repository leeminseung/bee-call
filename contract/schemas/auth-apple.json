{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.bee-call.invalid/schemas/auth-apple.json",
  "title": "POST /auth/apple, 200: signed in",
  "type": "object",
  "additionalProperties": false,
  "required": ["token", "person"],
  "properties": {
    "token": {"type": "string", "minLength": 16, "description": "The sign-in token every later request carries as Authorization: Bearer."},
    "person": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}
  }
}
