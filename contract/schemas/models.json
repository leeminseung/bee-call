{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.bee-call.invalid/schemas/models.json",
  "title": "GET /models?role=: the model choices of one role",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "models"
  ],
  "properties": {
    "role": {
      "enum": [
        "call",
        "worker"
      ]
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "The role's choices, the default first. Exactly one is the default.",
      "items": {
        "$ref": "defs.json#/$defs/model"
      },
      "contains": {
        "properties": {
          "default": {
            "const": true
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    }
  }
}
