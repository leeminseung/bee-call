#!/usr/bin/env python3
"""Fake `bee` CLI for tests. Logs each call and answers from fixtures; never touches Bee."""
import json, os, sys, time

args = sys.argv[1:]
with open(os.environ["FAKE_BEE_LOG"], "a") as f:
    f.write(json.dumps(args) + "\n")
cmd = [a for a in args if a != "--json"]
now_ms = int(time.time() * 1000)

def out(obj):
    print(json.dumps(obj))
    sys.exit(0)

if cmd[:1] == ["changed"]:
    out(json.load(open(os.environ["FAKE_BEE_CHANGED"])))
if cmd[:3] == ["facts", "list", "--unconfirmed"]:
    out({"facts": [{"id": 7, "text": "Bonus is 15%", "tags": ["work"], "created_at": now_ms, "confirmed": False}]})
if cmd[:2] == ["todos", "suggestions"]:
    out({"todoSuggestions": [{"id": 34, "text": "Ask about bonus terms", "emoji": "", "details": "", "alarm_at": None}]})
if cmd[:2] == ["conversations", "get"]:
    out({"conversation": {"id": int(cmd[2]), "short_summary": "Talked through a job offer", "start_time": now_ms}})
if cmd[:2] == ["conversations", "transcript"]:
    out({"conversationId": int(cmd[2]), "transcript": [
        {"spoken_at": now_ms - 60000, "speaker": "me", "text": "They offered 15 percent bonus."},
        {"spoken_at": now_ms - 30000, "speaker": "speaker_1", "text": "That sounds good."}]})
if cmd[:2] == ["facts", "confirm"]:
    out({"fact": {"id": int(cmd[2]), "confirmed": True}})
if cmd[:2] == ["facts", "update"]:
    out({"fact": {"id": int(cmd[2]), "confirmed": True}})
if cmd[:2] == ["todos", "create"]:
    out({"todo": {"id": 99, "text": cmd[cmd.index("--text") + 1]}})
if cmd[:2] == ["todos", "accept-suggestion"]:
    out({"todo": {"id": 100}})
print("unknown fake bee command: " + " ".join(cmd), file=sys.stderr)
sys.exit(2)
