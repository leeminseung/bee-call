#!/usr/bin/env python3
"""Fake `bee` CLI for tests. Logs each call and answers from fixtures; never touches Bee."""
import json, os, sys, time

args = sys.argv[1:]
with open(os.environ["FAKE_BEE_LOG"], "a") as f:
    f.write(json.dumps(args) + "\n")
folder = os.environ.get("BEE_CONFIG_DIR")
if folder:  # whose login the call used (beelink/cli.py use_bee)
    with open(os.environ["FAKE_BEE_LOG"] + ".who", "a") as f:
        f.write(json.dumps({"folder": folder, "args": args}) + "\n")
cmd = [a for a in args if a != "--json"]
now_ms = int(time.time() * 1000)
# A command that fails once: FAKE_BEE_FAIL_ONCE names a file holding the command's start ("todos create"); the
# file goes away when it fails, so the next try works.
fail_once = os.environ.get("FAKE_BEE_FAIL_ONCE")
if fail_once and os.path.exists(fail_once) and " ".join(cmd).startswith(open(fail_once).read().strip()):
    os.remove(fail_once)
    print("Bee is unavailable right now", file=sys.stderr)
    sys.exit(1)
# A command that always fails: FAKE_BEE_DOWN holds the command's start ("todos list").
down = os.environ.get("FAKE_BEE_DOWN")
if down and " ".join(cmd).startswith(down):
    print("Request failed with status 503", file=sys.stderr)
    sys.exit(1)
# A command Bee carries out but answers late: FAKE_BEE_SLOW holds the command's start and the seconds it takes
# ("todos create 3"). The call is already in the log (Bee has it) when the wait starts.
slow = os.environ.get("FAKE_BEE_SLOW")
if slow and " ".join(cmd).startswith(slow.rsplit(" ", 1)[0]):
    time.sleep(float(slow.rsplit(" ", 1)[1]))
# A command Bee carries out and then fails once, as a gateway error after Bee stored the todo does:
# FAKE_BEE_FAIL_AFTER_ONCE names a file holding the command's start, as FAKE_BEE_FAIL_ONCE does.
fail_after = os.environ.get("FAKE_BEE_FAIL_AFTER_ONCE")
failing_after = bool(fail_after and os.path.exists(fail_after)
                     and " ".join(cmd).startswith(open(fail_after).read().strip()))
# The todos Bee has, kept in the file FAKE_BEE_TODOS names (none when it is not set).
todos_file = os.environ.get("FAKE_BEE_TODOS")

def stored():
    return json.load(open(todos_file)) if todos_file and os.path.exists(todos_file) else []

def out(obj):
    if failing_after:
        os.remove(fail_after)
        print("Request failed with status 504", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(obj))
    sys.exit(0)

# One person's login, kept in BEE_CONFIG_DIR: a file named "approve" there stands for the person tapping the
# approval link.
if cmd == ["login", "--no-wait"]:
    os.makedirs(folder, exist_ok=True)
    open(os.path.join(folder, "pairing-prod.json"), "w").write("{}")
    print("Authentication link: https://bee.computer/connect#fake-pairing\n")
    sys.exit(0)
if cmd == ["login"]:
    while not os.path.exists(os.path.join(folder, "approve")):
        time.sleep(0.05)
    open(os.path.join(folder, "token-prod"), "w").write("fake")
    print("Connected to the Bee account of Test Person.")
    sys.exit(0)
if cmd == ["status"]:
    print("API: production" + ("\nLogged in as Test Person." if folder and os.path.exists(os.path.join(folder, "token-prod"))
                               else "\nNot logged in."))
    sys.exit(0)
if cmd == ["logout"]:
    if folder and os.path.exists(os.path.join(folder, "token-prod")):
        os.remove(os.path.join(folder, "token-prod"))
    print("Logged out.")
    sys.exit(0)

if cmd[:1] == ["changed"]:
    out(json.load(open(os.environ["FAKE_BEE_CHANGED"])))
if cmd[:3] == ["facts", "list", "--unconfirmed"]:
    out({"facts": [{"id": 7, "text": "Bonus is 15%", "tags": ["work"], "created_at": now_ms, "confirmed": False}]})
if cmd[:2] == ["todos", "suggestions"]:
    out({"todoSuggestions": [{"id": 34, "text": "Ask about bonus terms", "emoji": "", "details": "", "alarm_at": None}]})
if cmd[:2] in (["conversations", "get"], ["conversations", "transcript"]) and cmd[2] == "999":
    out({"conversation": None, "transcript": None})  # a conversation Bee returns as null
if cmd[:2] == ["conversations", "get"]:
    out({"conversation": {"id": int(cmd[2]), "short_summary": "Talked through a job offer", "start_time": now_ms}})
if cmd[:2] == ["conversations", "transcript"]:
    out({"conversationId": int(cmd[2]), "transcript": [
        {"spoken_at": now_ms - 60000, "speaker": "me", "text": "They offered 15 percent bonus."},
        {"spoken_at": now_ms - 30000, "speaker": "speaker_1", "text": "That sounds good."}]})
if cmd[:2] == ["today", "--context"]:
    out({"date": "2026-10-13", "todayBrief": {"calendar_events": [{"title": "Team offsite planning"}], "emails": [],
                                              "timezone": "Asia/Seoul"},
         "dailySummary": "Spent the morning on offer emails.", "activeTodos": [{"id": 51, "text": "Reply to the recruiter"}],
         "recentNotes": [], "recentConversations": [{"id": 5, "start_time": now_ms - 3600000,
                                                     "short_summary": "Talked through a job offer", "utterances_count": 40}]})
if cmd[:2] == ["conversations", "list"]:
    out({"conversations": [{"id": 5, "start_time": now_ms - 3600000, "short_summary": "Talked through a job offer",
                            "utterances_count": 40},
                           {"id": 4, "start_time": now_ms - 86400000, "short_summary": "Planned a Saturday hike with Dana",
                            "utterances_count": 12}], "next_cursor": None, "timezone": "Asia/Seoul"})
if cmd[:1] == ["me"]:
    out({"id": 1, "first_name": "Matt", "last_name": "Lee", "timezone": "Asia/Seoul"})
if cmd[:2] == ["daily", "find"]:
    out({"daily_summary": {"id": 3, "summary": "Hiked with Dana in the morning, then worked on slides."}})
if cmd[:1] == ["search"]:
    out({"results": [{"conversation_id": 4, "short_summary": "Planned a Saturday hike with Dana"}]})
if cmd[:2] == ["facts", "confirm"]:
    out({"fact": {"id": int(cmd[2]), "confirmed": True}})
if cmd[:2] == ["facts", "update"]:
    out({"fact": {"id": int(cmd[2]), "confirmed": True}})
# Bee answers a new todo either wrapped ({"todo": {...}}) or as the todo itself, as the CLI's own parser allows
# (parseTodoResponse in bee 0.7.3); FAKE_BEE_BARE_TODO=1 gives the bare form.
def made(todo):
    out(todo if os.environ.get("FAKE_BEE_BARE_TODO") else {"todo": todo})

if cmd[:2] == ["todos", "create"]:
    todo = {"id": 99 + len(stored()), "text": cmd[cmd.index("--text") + 1], "created_at": now_ms, "completed": False}
    if todos_file:
        json.dump(stored() + [todo], open(todos_file, "w"))
    made(todo)
if cmd[:2] == ["todos", "list"]:  # in the order they were made, a page at a time
    limit = int(cmd[cmd.index("--limit") + 1]) if "--limit" in cmd else 50
    start = int(cmd[cmd.index("--cursor") + 1]) if "--cursor" in cmd else 0
    more = start + limit < len(stored())
    out({"todos": stored()[start:start + limit], "next_cursor": str(start + limit) if more else None,
         "timezone": "Asia/Seoul"})
if cmd[:2] == ["todos", "accept-suggestion"]:
    if os.environ.get("FAKE_BEE_ACCEPT_ANSWER") == "suggestion":  # an answer that is not a todo at all
        out({"id": int(cmd[2]), "text": "Ask about bonus terms", "accepted": True})
    made({"id": 100, "text": "Ask about bonus terms", "created_at": now_ms, "completed": False})
if cmd[:2] == ["todos", "delete"]:
    out({"deleted": True, "id": int(cmd[2])})
if cmd[:2] == ["facts", "get"]:
    out({"fact": {"id": int(cmd[2]), "text": "Bonus is 15%", "confirmed": False}})
print("unknown fake bee command: " + " ".join(cmd), file=sys.stderr)
sys.exit(2)
