# LiveKit Cloud project. Filled by `lk app env -w`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AWS: a named profile in ~/.aws. Never put AWS keys in this file.
AWS_PROFILE=bee-call
# Transcribe, Polly and AgentCore run in Sydney (the account's fixed Region).
AWS_REGION=ap-southeast-2
# Region for Claude on Bedrock: ap-southeast-2 or us-east-1.
BEDROCK_REGION=ap-southeast-2

# ElevenLabs (optional): the AI's voice with TTS=elevenlabs (voice/voices.py), and narration. The key needs
# Text to Speech, and Voices read for probes/voice_samples.py.
ELEVENLABS_API_KEY=
# TTS=polly
# ELEVENLABS_VOICE=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STABILITY=

# Where each person's folder, settings and Bee login live (voice/people.py), data/ when unset.
# BEE_CALL_DATA=data
# On a Mac only: requests made on the Mac without a sign-in act as this approved person. Never on a server.
# BEE_CALL_DEV_PERSON=matt
# On a server: its public host name, which the session screen accepts besides local names.
# BEE_CALL_PUBLIC_HOST=call.example.com

# The call language and the time an offer suggests are each person's settings now (language, call_time).
# These remain only as the defaults of the --rules test path in voice/outbound.py.
# CALL_TIME=21:00
# CALL_LANGUAGE=en

# VoIP push, so the AI's calls ring a closed or locked iPhone (voice/voip_push.py). The .p8 key comes from
# the Apple Developer account (Keys, Apple Push Notifications service); keep the file outside this repository.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.leeminseung.beecall
