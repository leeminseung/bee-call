# LiveKit Cloud project. Filled by `lk app env -w`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AWS: a named profile in ~/.aws. Never put AWS keys in this file.
AWS_PROFILE=bee-call
# Transcribe, Polly and AgentCore run in Sydney (the account's fixed Region).
AWS_REGION=ap-southeast-2
# Region for Claude on Bedrock: ap-southeast-2 or us-east-1.
BEDROCK_REGION=ap-southeast-2

# ElevenLabs (optional, test voices and narration)
ELEVENLABS_API_KEY=

# VoIP push, so the AI's calls ring a closed or locked iPhone (voice/voip_push.py). The .p8 key comes from
# the Apple Developer account (Keys, Apple Push Notifications service); keep the file outside this repository.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.leeminseung.beecall
